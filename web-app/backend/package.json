{
  "name": "prompt-engine-api",
  "version": "2.0.0",
  "description": "Prompt Engine API: analyst, drafter, critic prompt pipeline with free-tier provider hopping",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/models/migrate.js",
    "migrate:status": "node src/models/migrate.js --status",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node scripts/eval.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.20.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vitest": "^2.1.9"
  }
}
