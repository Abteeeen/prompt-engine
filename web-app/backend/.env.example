# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
# Public URL of the frontend (sent as HTTP-Referer to OpenRouter)
APP_URL=http://localhost:5173

# ── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
# Used by the API (users, saved prompts, analytics) and by setup_db.js / fix_db.js
DATABASE_URL=postgresql://user:password@localhost:5432/prompt_engineering

# Supabase (optional: gold-standard prompt store + learned patterns)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Shared secret for POST /api/prompts/seed (no default; endpoint is disabled when unset)
SEED_API_KEY=

# ── LLM providers (free-tier hopping) ────────────────────────────────────────
# Set at least ONE key. Every provider uses the OpenAI chat-completions format.
# A provider may list several keys separated by commas (GROQ_API_KEY=key1,key2);
# keys are used round-robin and a key that hits a limit is cooled down automatically:
#   429 rate limit  -> 60s (or the Retry-After header)      429/402 quota or credits -> 6h
#   401/403 bad key -> 24h                                   5xx / timeout -> provider 2 min
# When every key of a provider is cooling down, the next provider in LLM_PROVIDER_ORDER is used.
LLM_PROVIDER_ORDER=groq,cerebras,gemini,sambanova,mistral,github,cloudflare,together,huggingface,cohere,openrouter,custom

# Optional per-provider daily request caps, so a provider is parked before it 429s:
# LLM_DAILY_LIMITS=groq:14000,gemini:250,cerebras:5000
# Optional file to persist cooldown state across restarts:
# LLM_STATE_FILE=./.llm-state.json

# Groq            https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Cerebras        https://cloud.cerebras.ai  (API Keys)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
# Google AI Studio (Gemini)   https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# SambaNova       https://cloud.sambanova.ai  (API Keys)
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
# Mistral         https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# GitHub Models   https://github.com/settings/personal-access-tokens  (fine-grained PAT with "Models" permission)
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
# Cloudflare Workers AI   https://dash.cloudflare.com -> AI -> Workers AI  (needs account id + token)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Together        https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free
# Hugging Face Inference Providers   https://huggingface.co/settings/tokens  ("Make calls to Inference Providers")
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
# HF_BASE_URL=https://<your-endpoint>.endpoints.huggingface.cloud/v1/chat/completions   (dedicated endpoint)
# Cohere          https://dashboard.cohere.com/api-keys  (trial key)
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
# OpenRouter      https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Self-hosted OpenAI-compatible server (vLLM, TGI, Ollama, LM Studio, LiteLLM)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1
# Any provider's URL can be overridden with <NAME>_BASE_URL (e.g. GROQ_BASE_URL) for proxies or testing.

# ── Per-role model overrides (optional) ──────────────────────────────────────
# Format: "<provider>:<model>", "<provider>", or "<model>" (on first configured provider)
# LLM_MODEL_RESEARCHER=groq:llama-3.3-70b-versatile
# LLM_MODEL_DRAFTER=huggingface:Qwen/Qwen2.5-72B-Instruct
# LLM_MODEL_CRITIC=groq
# LLM_MODEL_OPTIMIZER=huggingface:deepseek-ai/DeepSeek-V3
# LLM_MODEL_JURY=groq
# LLM_MODEL_LEARNER=groq:llama-3.1-8b-instant

# Arena contestants: comma list of "<provider>:<model>". Default: one per configured provider.
# ARENA_MODELS=groq:llama-3.3-70b-versatile,huggingface:Qwen/Qwen2.5-72B-Instruct,huggingface:mistralai/Mistral-Small-24B-Instruct-2501

# Call tuning
LLM_TIMEOUT_MS=45000
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.75

# Pipeline quality loop: the critic re-scores and rewrites until the prompt reaches
# LLM_QUALITY_TARGET (out of 30) or LLM_MAX_REFINEMENTS critique passes are spent.
# Each pass is one extra model call; 1 is fastest, 2 is the default, 3 is thorough.
LLM_QUALITY_TARGET=27
LLM_MAX_REFINEMENTS=2

# ── Optional enrichment ──────────────────────────────────────────────────────
# Tavily web search (skipped entirely when unset)
TAVILY_API_KEY=
