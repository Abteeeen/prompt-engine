# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development            # production enables strict checks (see src/config.js)
LOG_LEVEL=info
# Browser origins allowed to call the API (comma-separated). Required in production.
FRONTEND_URL=http://localhost:5173
# Public URL of the app (sent as HTTP-Referer to OpenRouter)
APP_URL=http://localhost:5173

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Supabase -> Project Settings -> Database -> Connection string (URI), "Transaction" pooler, port 6543.
# Migrations in ./migrations run automatically at boot (AUTO_MIGRATE=false to disable).
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# PGSSL_REJECT_UNAUTHORIZED=false   # only if your host's certificate chain is not trusted
# PG_POOL_MAX=5

# ── Auth ─────────────────────────────────────────────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web). Same id goes in the frontend.
GOOGLE_CLIENT_ID=
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated emails that get the admin role on sign-in (provider status, analytics dashboard)
ADMIN_EMAILS=

# ── Quotas (generations per UTC day; 0 = unlimited) ──────────────────────────
QUOTA_GUEST_PER_DAY=5
QUOTA_FREE_PER_DAY=15
QUOTA_PRO_PER_DAY=0
MAX_REQUEST_CHARS=4000
MAX_PROMPT_CHARS=20000

# ── LLM providers (free-tier hopping) ────────────────────────────────────────
# Set at least ONE key. Every provider speaks the OpenAI chat-completions format.
# A provider may list several keys separated by commas; keys rotate and a key that hits a
# limit is cooled down automatically:
#   429 per-minute  -> 60s (or Retry-After)      429 daily quota -> until the provider's midnight
#   402 credits     -> 6h                        401/403 bad key -> 24h      5xx/timeout -> 2 min
# When every key of a provider is cooling down, the next provider in LLM_PROVIDER_ORDER is used.
# Hop ACROSS providers only. Multiple accounts on one provider breaks their terms.
LLM_PROVIDER_ORDER=groq,gemini,cloudflare,sambanova,openrouter,mistral,cerebras,nvidia,zai,huggingface,cohere,together,custom

# Park a provider before it starts returning 429 (requests per day):
# LLM_DAILY_LIMITS=groq:900,gemini:240,sambanova:18,cloudflare:400
# Persist cooldown state across restarts:
# LLM_STATE_FILE=./.llm-state.json

# Groq                 https://console.groq.com/keys           free: gpt-oss-120b 1K req/day, 200K tok/day
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google AI Studio     https://aistudio.google.com/apikey      free: check https://aistudio.google.com/rate-limit (trains on free data)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Cloudflare Workers AI  dash.cloudflare.com -> AI -> Workers AI   free: 10K neurons/day
CF_ACCOUNT_ID=
CF_API_TOKEN=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
# SambaNova            https://cloud.sambanova.ai              free: 20 req/day per model
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
# OpenRouter           https://openrouter.ai/settings/keys     free models: 50 req/day (1,000/day after a one-time $10 top-up)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Mistral              https://console.mistral.ai/api-keys     free plan: $10/month credit (trains on free data by default)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Cerebras             https://cloud.cerebras.ai               needs a verified card; 1M tok/day
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# NVIDIA Build         https://build.nvidia.com                prototyping terms; overflow only
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Z.ai                 https://z.ai/manage-apikey/apikey-list  GLM Flash models at $0, concurrency 1; overflow only
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
# Hugging Face         https://huggingface.co/settings/tokens  $0.10/month credit; token needs "Make calls to Inference Providers"
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
# HF_BASE_URL=https://<endpoint>.endpoints.huggingface.cloud/v1/chat/completions
# Cohere (trial, non-commercial)  https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
# Together (paid, $5 minimum)     https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Self-hosted OpenAI-compatible server (vLLM, TGI, Ollama, LM Studio, LiteLLM)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1
# Any provider's URL can be overridden with <NAME>_BASE_URL (GROQ_BASE_URL, GEMINI_BASE_URL, ...).

# ── Per-role model overrides (optional) ──────────────────────────────────────
# "<provider>:<model>" | "<provider>" | "<model>" (on the first configured provider)
# LLM_MODEL_RESEARCHER=groq
# LLM_MODEL_DRAFTER=gemini:gemini-2.5-flash
# LLM_MODEL_CRITIC=groq
# LLM_MODEL_OPTIMIZER=gemini:gemini-2.5-pro
# LLM_MODEL_LEARNER=groq:openai/gpt-oss-20b

# Call tuning
LLM_TIMEOUT_MS=45000
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.75
LLM_REASONING_EFFORT=low        # gpt-oss models on Groq/Cerebras
# Critic loop: re-score and rewrite until LLM_QUALITY_TARGET (of 30) or LLM_MAX_REFINEMENTS passes.
LLM_QUALITY_TARGET=27
LLM_MAX_REFINEMENTS=2

# ── Optional enrichment ──────────────────────────────────────────────────────
# Tavily web search on every generation. Off unless both are set.
TAVILY_API_KEY=
TAVILY_ON_GENERATE=false
